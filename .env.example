# ==============================================================================
# SEVA PASS — Unified Project Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual Supabase credentials.
# The backend and frontend directories also have their respective .env files.

# --- SUPABASE CLOUD CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SECRET: Server-Side ONLY (Never commit or expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Direct PostgreSQL Connection (Optional)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection URI
# e.g., postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- SERVICE SETTINGS ---
DB_MODE=sqlite
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
JWT_SECRET=seva-pass-production-auth-secret-key-ed25519-2026
