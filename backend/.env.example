# ==============================================================================
# SEVA PASS — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.

# --- SERVER SETTINGS ---
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- DATABASE CONFIGURATION ---
# Mode options:
#   "sqlite"   -> Uses local SQLite file (default, ready for offline & testing)
#   "supabase" -> Uses cloud Supabase PostgreSQL connection
DB_MODE=sqlite
SQLITE_DB_NAME=seva_pass.db

# --- SUPABASE CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API
# 1. Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon/Public Key (Client Safe)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (SECRET: Server-Side ONLY, bypasses RLS)
# WARNING: NEVER expose this key to frontend or git!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Supabase PostgreSQL Connection String (Optional direct DB connection)
# Found in: Supabase -> Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- AUTHENTICATION & CRYPTOGRAPHY ---
JWT_SECRET=seva-pass-production-auth-secret-key-ed25519-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ed25519 Signing Authority (Required in production for continuous key persistence)
KEY_ID=seva-ed25519-v1
ED25519_PRIVATE_KEY_HEX=
ED25519_PRIVATE_KEY_PEM=

# Default Administrator Account (used during seed/bootstrap if profiles table is empty)
SEVA_ADMIN_USER=admin
SEVA_ADMIN_PASS=SevaAdmin@2026#Secure
SEVA_ADMIN_EMAIL=admin@sevapass.internal
