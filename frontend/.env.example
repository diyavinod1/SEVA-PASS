# ==============================================================================
# SEVA PASS — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.

# --- BACKEND API ENDPOINT ---
# Base URL for the FastAPI backend service
VITE_API_URL=http://127.0.0.1:8000

# --- SUPABASE PUBLIC CLIENT CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API
# 1. Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon/Public Key (Safe to expose to browser clients)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# CRITICAL SECURITY RULE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or VITE_SUPABASE_SERVICE_ROLE_KEY here.
# Service-role keys bypass all Row Level Security and must only live on the backend.
# ==============================================================================
