# ==============================================================================
# SEVA PASS Root .gitignore
# ==============================================================================

# Environment files and credentials (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.local

# Database and cryptographic private keys
*.db
*.db-journal
*.db-wal
*.db-shm
*.pem
*.key

# Python bytecode and environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
venv/
.venv/
env/

# Frontend builds and dependencies
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system and IDE
.DS_Store
.vscode/
.idea/
